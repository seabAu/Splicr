# SPLICR-MANAGED-SITE v1
# Port 80 and the ACME webroot are managed by an existing SPLICR hostname vhost.
# SPLICR-EXTERNAL-HTTP-VHOST

server {
    # The hostname is selected through SNI and does not become the shared
    # server's default TLS application.
    listen __SPLICR_PUBLIC_HTTPS_PORT__ ssl;
    server_name __SPLICR_PUBLIC_HOST__;

    access_log /home/logs/nginx/splicr.access.log;
    error_log /home/logs/nginx/splicr.error.log warn;

    ssl_certificate /etc/letsencrypt/live/__SPLICR_PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SPLICR_PUBLIC_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SPLICR:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 30m;
    client_body_timeout 300s;
    send_timeout 3600s;

    auth_basic "SPLICR";
    auth_basic_user_file /etc/nginx/.htpasswd-splicr;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:__SPLICR_HTTP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_intercept_errors off;
    }
}
