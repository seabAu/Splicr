# Provider credentials. Keep these server-side; Inworld supplies its value already Base64-encoded.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
INWORLD_API_KEY=

# Service defaults
SPLICR_DATA_DIR=data
# Local authentication is optional. Production Compose forces both values to true.
SPLICR_AUTH_ENABLED=false
SPLICR_AUTH_COOKIE_SECURE=false
SPLICR_AUTH_SESSION_SECONDS=43200
# Desktop installs use the OS keyring. Containers override this to encrypted-file and
# mount a Fernet key through SPLICR_SECRET_VAULT_KEY_FILE.
SPLICR_SECRET_VAULT_BACKEND=keyring
SPLICR_SECRET_VAULT_KEY_FILE=
SPLICR_SECRET_VAULT_PATH=
SPLICR_MAX_SOURCE_BYTES=1000000
SPLICR_MAX_SOURCE_WORDS=100000
SPLICR_MAX_UPLOAD_BYTES=25000000
SPLICR_MAX_OUTPUT_PCM_BYTES=4000000000
SPLICR_GEMINI_MODEL=gemini-3.1-flash-tts-preview
SPLICR_GEMINI_VOICE=Kore
SPLICR_DEEPGRAM_MODEL=aura-2
SPLICR_DEEPGRAM_VOICE=aura-2-thalia-en
SPLICR_DEEPGRAM_API_URL=https://api.deepgram.com/v1/speak
SPLICR_DEEPGRAM_PACING_SECONDS=0
SPLICR_INWORLD_MODEL=inworld-tts-2
SPLICR_INWORLD_VOICE=Ashley
SPLICR_INWORLD_API_URL=https://api.inworld.ai/tts/v1/voice
SPLICR_INWORLD_PACING_SECONDS=0
# Optional isolated local model environments. Point each setting at that environment's Python
# executable; do not copy environments, weights, or model caches into the repository.
SPLICR_KOKORO_PYTHON=
SPLICR_QWEN3_PYTHON=
SPLICR_AUDIO8_PYTHON=
SPLICR_LOCAL_ENGINE_STARTUP_TIMEOUT_SECONDS=600
SPLICR_LOCAL_ENGINE_REQUEST_TIMEOUT_SECONDS=300
SPLICR_CHUNK_MAX_BYTES=3800
SPLICR_CHUNK_MAX_WORDS=350
SPLICR_PACING_SECONDS=3
SPLICR_PROVIDER_TIMEOUT_SECONDS=300
# Ignore ambient HTTP(S)_PROXY variables by default; opt in only when this service should use them.
SPLICR_TRUST_ENV_PROXIES=false
SPLICR_MAX_ATTEMPTS=3
SPLICR_BACKOFF_BASE_SECONDS=5
SPLICR_BACKOFF_MAX_SECONDS=60
SPLICR_BACKOFF_JITTER_SECONDS=1
SPLICR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
